---
import blogData from '../../data/blog.json';

type Post = {
  slug: string;
  title: string;
  image: string;
  date:string;
  content: string;
};

export async function getStaticPaths() {
  const posts: Post[] = blogData;

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post }: { post: Post } = Astro.props;
