---
import blogData from '../../data/category.json';

type Category = {
  slug: string;
  title: string;
  image: string;
  content: string;
};

export async function getStaticPaths() {
  const categories: Category[] = blogData;

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category }: { category: Category } = Astro.props;
