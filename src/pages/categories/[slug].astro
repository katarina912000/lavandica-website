---
import blogData from '../../data/category.json';


type Category = {
  slug: string;
  title: string;
  image1: string;
  image2: string;
  image3: string;
  image4: string;
  title1: string;
  subtitle1: string;
  ml1: string;
  contentDesc1: string;
  contentAffect1: string;
};

export async function getStaticPaths() {
  const categories: Category[] = blogData;

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category }: { category: Category } = Astro.props;
---
<html lang="sr">
  <head>
    <title>{category.title}</title>
    <link rel="stylesheet" href="/styles/category.css" />
			   <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inria+Serif:wght@300;400;700&subset=latin-ext&display=swap"
  /><meta charset="UTF-8" />

	<script src="/script.js" defer></script>
  </head>
  <body>
    <main>
       <div class="navbar">
		  <a href="/" class="a-img"><img  style="width:100px; margin-right: 230px" src="/images/logo.png">
			</a>
					<nav>
						<div  class="categories-list">
							<a href="/#categories" class="a-category">Kategorije</a> 
							<div class="dropdown-content" style="border-radius: 0%;">	
			                     
								
								<a href="/categories/lice">Lice</a>									
								<a href="/categories/telo">Telo</a>									
								<a href="/categories/kosa">Kosa</a>
								<a href="/categories/hemija">Hemija</a>							
															
 							</div>
						</div>
						<a href="/#aboutme">O meni</a>
							<a href="/#blog">Blog</a>
							<a href="/#contact" >Kontakt</a>						  
					</nav>
					      

        </div>
      <h1 class="title" style="color: aliceblue;">{category.title}</h1> <!--ovde je frkica jer mi stoji za lice fiksno treba da mi stoji
	  title -->



<div class="slider-wrapper">
  <button class="arrow left">‹</button>

  <div class="img-cat">
    <div class="img1-cat">
      <button class="openPopup">
        <img src={category.image1} class="img-category" />
      </button>
    </div>

    <div class="img1-cat">
      <button class="openPopup">
        <img src={category.image2} class="img-category" />
      </button>
    </div>

    <div class="img1-cat">
      <button class="openPopup">
        <img src={category.image3} class="img-category" />
      </button>
    </div>

    <div class="img1-cat">
      <button class="openPopup">
        <img src={category.image4} class="img-category" />
      </button>
    </div>


    <!-- ovde idu sledeći proizvodi -->
    <div class="img1-cat">
      <button class="openPopup">
        <img src={category.image4} class="img-category" />
      </button>
    </div>

 <div class="img1-cat">
      <button class="openPopup">
        <img src={category.image3} class="img-category" />
      </button>
    </div>

  </div>
  <button class="arrow right">›</button>
</div>


<div id="popupOverlay">
  <div class="popup">
    <button class="closeBtn">&times;</button>

    <div class="popup-left">
      <img src={category.image1} class="img-category" />
      <p class="non-white-text">Proverite dostupnost</p>
      <p class="non-white-text">Standardna isporuka 2–5 radnih dana</p>
    </div> 

    <div class="popup-right">
      <h2>{category.title1}</h2>
      <h5>{category.subtitle1}</h5>
      <h5>{category.ml1}</h5>

      <b><p class="non-white-text">Opis proizvoda</p></b>
      <p class="non-white-text">{category.contentDesc1}</p>

      <b><p class="non-white-text">Delovanje</p></b>
      <p class="non-white-text">{category.contentAffect1}</p>
    </div>
  </div>
</div>



</main>
 <footer class="footer">
    <svg style="margin-top: 10px;" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
			<g clip-path="url(#clip0_122_24)">
			<rect width="23.057" height="24" transform="translate(0.166504)" fill="black" fill-opacity="0.25"/>
			<path d="M16.9789 6.5H16.9885M6.89143 2H16.4985C19.1514 2 21.3021 4.23858 21.3021 7V17C21.3021 19.7614 19.1514 22 16.4985 22H6.89143C4.23851 22 2.08789 19.7614 2.08789 17V7C2.08789 4.23858 4.23851 2 6.89143 2ZM15.5378 11.37C15.6564 12.2022 15.5198 13.0522 15.1475 13.799C14.7753 14.5458 14.1862 15.1514 13.4642 15.5297C12.7422 15.9079 11.9241 16.0396 11.126 15.9059C10.328 15.7723 9.59079 15.3801 9.01925 14.7852C8.4477 14.1902 8.07092 13.4229 7.94251 12.5922C7.8141 11.7616 7.94059 10.9099 8.30399 10.1584C8.66738 9.40685 9.24919 8.79374 9.96664 8.40624C10.6841 8.01874 11.5007 7.87659 12.3002 8C13.1158 8.12588 13.8708 8.52146 14.4538 9.12831C15.0368 9.73515 15.4169 10.5211 15.5378 11.37Z" stroke="#F3F3F3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
			</g>
			<defs>
			<clipPath id="clip0_122_24">
			<rect width="23.057" height="24" fill="white" transform="translate(0.166504)"/>
			</clipPath>
			</defs>

			</svg>
			<a href="https://www.instagram.com/lavandica1/" style="color: #f3f3f3;">@lavandica1</a>
            <p>Made with ❤️, by Kate</p>
 		

        </footer>
      


<script>

document.addEventListener("DOMContentLoaded", () => {
  const slider = document.querySelector(".img-cat") as HTMLElement;
  const cards = slider.querySelectorAll(".img1-cat") as NodeListOf<HTMLElement>;

  const leftBtn = document.querySelector(".arrow.left") as HTMLButtonElement;
  const rightBtn = document.querySelector(".arrow.right") as HTMLButtonElement;

  const gap = 16;

  // širina jedne kartice + gap
  const cardWidth = cards[0].offsetWidth + gap;

  rightBtn.addEventListener("click", () => {
    slider.scrollBy({
      left: cardWidth,
      behavior: "smooth",
    });
  });

  leftBtn.addEventListener("click", () => {
    slider.scrollBy({
      left: -cardWidth,
      behavior: "smooth",
    });
  });
});


  /* ================= POPUP ================= */


</script>
<script>

document.addEventListener("DOMContentLoaded", () => {
  const popupOverlay = document.getElementById("popupOverlay") as HTMLElement;
  const popup = popupOverlay.querySelector(".popup") as HTMLElement;
  const closeBtn = popup.querySelector(".closeBtn") as HTMLButtonElement;

  const openButtons = document.querySelectorAll(
    ".openPopup"
  ) as NodeListOf<HTMLButtonElement>;

  // OTVARANJE POPUPA
  openButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      popupOverlay.style.display = "flex";
      document.body.style.overflow = "hidden"; // zamrzni pozadinu
    });
  });

  // ZATVARANJE NA X
  closeBtn.addEventListener("click", () => {
    popupOverlay.style.display = "none";
    document.body.style.overflow = "";
  });

  // ZATVARANJE KLIKOM NA OVERLAY
  popupOverlay.addEventListener("click", () => {
    popupOverlay.style.display = "none";
    document.body.style.overflow = "";
  });

  // DA SE NE ZATVORI KLIKOM UNUTAR POPUPA
  popup.addEventListener("click", (e) => {
    e.stopPropagation();
  });
});

</script>



  </body>
</html>

 